{
  "name": "screen-buddy",
  "version": "0.1.0",
  "description": "A desktop cat companion for self-care reminders",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/THE-Nullb0rn/Screen-Buddy.git"
  },
  "homepage": "https://github.com/THE-Nullb0rn/Screen-Buddy",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "lint": "eslint src --ext .js,.jsx"
  },
  "keywords": [
    "electron",
    "desktop",
    "companion",
    "self-care",
    "reminder",
    "cat",
    "linux",
    "windows",
    "wayland",
    "hyprland"
  ],
  "author": "nullborn",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.0.1",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "dbus-next": "^0.10.2",
    "lucide-react": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uiohook-napi": "^1.5.5"
  }
}
